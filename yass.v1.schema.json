{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shakefu.github.io/yass/v1.schema.json",
  "title": "yass v1 document",
  "description": "Per-document schema for a yass v1 .yass.yaml stream. Each YAML document validates as a preamble, a spec, or a design. Stream-level rules (exactly one preamble first, name uniqueness, ref resolution, relation target kinds) are out of scope and remain in `yass validate`.",
  "oneOf": [
    { "$ref": "#/$defs/preamble" },
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/design" }
  ],

  "$defs": {
    "preamble": {
      "title": "Preamble",
      "type": "object",
      "not": { "anyOf": [ { "required": ["spec"] }, { "required": ["design"] } ] },
      "required": ["description", "version"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "version": { "const": "v1" },
        "related": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "spec": {
      "title": "Spec",
      "type": "object",
      "required": ["spec"],
      "additionalProperties": false,
      "properties": {
        "spec": { "$ref": "#/$defs/documentName" },
        "INPUT": { "$ref": "#/$defs/slot" },
        "RETURN": { "$ref": "#/$defs/slot" },
        "ERROR": { "$ref": "#/$defs/slot" },
        "SIDE-EFFECT": { "$ref": "#/$defs/slot" },
        "INVARIANT": { "$ref": "#/$defs/slot" }
      }
    },

    "design": {
      "title": "Design",
      "type": "object",
      "required": ["design", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "design": { "$ref": "#/$defs/documentName" },
        "type": { "enum": ["constraint", "algorithm", "procedure", "schema", "catalog"] },
        "format": { "type": "string", "minLength": 1 },
        "content": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "schema" } } },
          "then": { "required": ["format"] },
          "else": { "not": { "required": ["format"] } }
        },
        {
          "if": { "properties": { "type": { "const": "catalog" } } },
          "then": { "properties": { "content": { "$ref": "#/$defs/catalog" } } },
          "else": { "properties": { "content": { "type": "string" } } }
        }
      ]
    },

    "catalog": {
      "title": "Catalog content (records keyed by identifier; every record carries the same field names, which validation checks)",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
      }
    },

    "documentName": {
      "title": "Spec or design name (a yass keyword in any casing is reserved)",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "not": { "pattern": "^([Ii][Nn][Pp][Uu][Tt]|[Rr][Ee][Tt][Uu][Rr][Nn]|[Ee][Rr][Rr][Oo][Rr]|[Ss][Ii][Dd][Ee]-[Ee][Ff][Ff][Ee][Cc][Tt]|[Ii][Nn][Vv][Aa][Rr][Ii][Aa][Nn][Tt]|[Mm][Uu][Ss][Tt]|[Mm][Uu][Ss][Tt]-[Nn][Oo][Tt]|[Ss][Hh][Oo][Uu][Ll][Dd]|[Ss][Hh][Oo][Uu][Ll][Dd]-[Nn][Oo][Tt]|[Mm][Aa][Yy]|[Ww][Hh][Ee][Nn]|[Cc][Oo][Nn][Ff][Oo][Rr][Mm][Ss]|[Uu][Ss][Ee][Ss]|[Ss][Ee][Ee])$" }
    },

    "slot": {
      "title": "Slot",
      "type": "array",
      "items": { "$ref": "#/$defs/obligation" }
    },

    "refTarget": {
      "title": "RefTarget",
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-][A-Za-z0-9_./-]*@)?[A-Za-z0-9._-]+(::(INPUT|RETURN|ERROR|SIDE-EFFECT|INVARIANT))?$"
    },

    "refTargetNoSlot": {
      "title": "RefTarget (design target; no ::SLOT — a design carries no slots)",
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-][A-Za-z0-9_./-]*@)?[A-Za-z0-9._-]+$"
    },

    "obligation": {
      "title": "Obligation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "MUST": { "type": "string" },
        "MUST-NOT": { "type": "string" },
        "SHOULD": { "type": "string" },
        "SHOULD-NOT": { "type": "string" },
        "MAY": { "type": "string" },
        "WHEN": { "type": "string" },
        "CONFORMS": { "$ref": "#/$defs/refTarget" },
        "USES": { "$ref": "#/$defs/refTargetNoSlot" },
        "SEE": { "$ref": "#/$defs/refTarget" }
      },
      "oneOf": [
        {
          "title": "normative obligation (exactly one normativity keyword)",
          "oneOf": [
            { "required": ["MUST"] },
            { "required": ["MUST-NOT"] },
            { "required": ["SHOULD"] },
            { "required": ["SHOULD-NOT"] },
            { "required": ["MAY"] }
          ]
        },
        {
          "title": "reference-only obligation (no normativity, no WHEN, at least one relation)",
          "not": {
            "anyOf": [
              { "required": ["MUST"] },
              { "required": ["MUST-NOT"] },
              { "required": ["SHOULD"] },
              { "required": ["SHOULD-NOT"] },
              { "required": ["MAY"] },
              { "required": ["WHEN"] }
            ]
          },
          "anyOf": [
            { "required": ["CONFORMS"] },
            { "required": ["USES"] },
            { "required": ["SEE"] }
          ]
        }
      ]
    }
  }
}
