{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textla.dev/yass/v1.schema.json",
  "title": "yass v1 document",
  "description": "Per-document schema for a yass v1 .yass.yaml stream. Each YAML document validates as a preamble, a spec, or a design. Stream-level rules (exactly one preamble first, name uniqueness, ref resolution, relation target kinds) are out of scope and remain in `yass validate`.",
  "oneOf": [
    { "$ref": "#/$defs/preamble" },
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/design" }
  ],

  "$defs": {
    "preamble": {
      "title": "Preamble",
      "type": "object",
      "not": { "anyOf": [ { "required": ["spec"] }, { "required": ["design"] } ] },
      "required": ["description", "version"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "version": { "const": "v1" },
        "related": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "spec": {
      "title": "Spec",
      "type": "object",
      "required": ["spec"],
      "additionalProperties": false,
      "properties": {
        "spec": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "INPUT": { "$ref": "#/$defs/slot" },
        "RETURN": { "$ref": "#/$defs/slot" },
        "ERROR": { "$ref": "#/$defs/slot" },
        "SIDE-EFFECT": { "$ref": "#/$defs/slot" },
        "INVARIANT": { "$ref": "#/$defs/slot" }
      }
    },

    "design": {
      "title": "Design",
      "type": "object",
      "required": ["design", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "design": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "type": { "type": "string" },
        "content": { "type": "string" }
      }
    },

    "slot": {
      "title": "Slot",
      "type": "array",
      "items": { "$ref": "#/$defs/obligation" }
    },

    "refTarget": {
      "title": "RefTarget",
      "type": "string",
      "pattern": "^([A-Za-z0-9_./-]+@)?[A-Za-z0-9._-]+(::[A-Z][A-Z-]*)?$"
    },

    "refTargetNoSlot": {
      "title": "RefTarget (design target; no ::SLOT — a design carries no slots)",
      "type": "string",
      "pattern": "^([A-Za-z0-9_./-]+@)?[A-Za-z0-9._-]+$"
    },

    "obligation": {
      "title": "Obligation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "MUST": { "type": "string" },
        "MUST-NOT": { "type": "string" },
        "SHOULD": { "type": "string" },
        "SHOULD-NOT": { "type": "string" },
        "MAY": { "type": "string" },
        "WHEN": { "type": "string" },
        "CONFORMS": { "$ref": "#/$defs/refTarget" },
        "USES": { "$ref": "#/$defs/refTargetNoSlot" },
        "SEE": { "$ref": "#/$defs/refTarget" }
      },
      "oneOf": [
        {
          "title": "normative obligation (exactly one normativity keyword)",
          "oneOf": [
            { "required": ["MUST"] },
            { "required": ["MUST-NOT"] },
            { "required": ["SHOULD"] },
            { "required": ["SHOULD-NOT"] },
            { "required": ["MAY"] }
          ]
        },
        {
          "title": "reference-only obligation (no normativity, no WHEN, at least one relation)",
          "not": {
            "anyOf": [
              { "required": ["MUST"] },
              { "required": ["MUST-NOT"] },
              { "required": ["SHOULD"] },
              { "required": ["SHOULD-NOT"] },
              { "required": ["MAY"] },
              { "required": ["WHEN"] }
            ]
          },
          "anyOf": [
            { "required": ["CONFORMS"] },
            { "required": ["USES"] },
            { "required": ["SEE"] }
          ]
        }
      ]
    }
  }
}
