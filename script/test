#!/usr/bin/env bash
#
# script/test — build and test the yass CLI, then check the authored specs.
#
# The CLI is a Go module rooted at cli/. This builds it and runs its tests,
# after the shell-only installer tests, which need no toolchain. The built CLI
# then validates and lints the repository's own spec projects (script/check-specs).
#
# In CI a missing Go toolchain fails rather than skips: the release workflow
# gates on the CI test job, and a skip would turn that gate green with no Go
# tests run.

set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> install.sh + gen-formula"
script/test-install

if ! command -v go >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    echo "script/test: go toolchain not found in CI; failing rather than skipping" >&2
    exit 1
  fi
  echo "script/test: go toolchain not found; skipping cli tests" >&2
  exit 0
fi

cd cli

echo "==> gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "not gofmt'd:" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "==> go vet"
go vet ./...

echo "==> go test"
go test ./...

echo "==> go build"
bin=$(mktemp -d)
trap 'rm -rf "$bin"' EXIT INT TERM
go build -o "$bin/yass" .

cd ..

echo "==> check-specs tests"
YASS="$bin/yass" script/test-check-specs

echo "==> pre-commit-hook tests"
YASS="$bin/yass" script/test-pre-commit-hook

echo "==> check-specs"
YASS="$bin/yass" script/check-specs
