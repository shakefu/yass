#!/usr/bin/env bash
#
# script/test-install — behavior tests for install.sh and script/gen-formula.
#
# Needs only a POSIX userland plus curl and sha256sum/shasum, so it runs where
# the Go toolchain does not. Releases are faked as a file tree served over
# file:// URLs via YASS_REPO_URL, and the host platform is faked with a uname
# shim on PATH, so no test touches the network or depends on the real host.

set -euo pipefail

cd "$(dirname "$0")/.."
REPO_ROOT="$PWD"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

failures=0
ok() { echo "ok   $*"; }
bad() {
	echo "FAIL $*" >&2
	failures=$((failures + 1))
}

# fake_release DIR VERSION — build a release tree of every supported target
# under DIR, each archive holding a distinct runnable stand-in binary.
fake_release() {
	local dir="$1" ver="$2" target os arch tmp
	local assets="$dir/releases/download/v$ver"
	mkdir -p "$assets"
	for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do
		os="${target%/*}"
		arch="${target#*/}"
		tmp=$(mktemp -d)
		printf '#!/bin/sh\necho "yass %s v1 (%s_%s)"\n' "$ver" "$os" "$arch" >"$tmp/yass"
		chmod 0755 "$tmp/yass"
		tar -czf "$assets/yass_${ver}_${os}_${arch}.tar.gz" -C "$tmp" yass
		rm -rf "$tmp"
	done
	if command -v sha256sum >/dev/null 2>&1; then
		(cd "$assets" && sha256sum yass_* >checksums.txt)
	else
		(cd "$assets" && shasum -a 256 yass_* >checksums.txt)
	fi
}

# fake_uname DIR OS ARCH — write a uname shim into DIR.
fake_uname() {
	local dir="$1" os="$2" arch="$3"
	mkdir -p "$dir"
	cat >"$dir/uname" <<-EOF
		#!/bin/sh
		case "\${1:-}" in
		-m) echo "$arch" ;;
		*) echo "$os" ;;
		esac
	EOF
	chmod 0755 "$dir/uname"
}

# capture CMD [ARG...] — run a command that may fail, keeping its combined
# output in $out and its exit status in $status.
capture() {
	set +e
	out=$("$@" 2>&1)
	status=$?
	set -e
}

# run_install [ARG...] — run install.sh with the shimmed platform against the
# fixture repo, or against $repo when a case sets it.
FIXTURE="$work/repo"
SHIM="$work/shim"
run_install() {
	capture env PATH="$SHIM:$PATH" YASS_REPO_URL="file://${repo:-$FIXTURE}" \
		sh "$REPO_ROOT/install.sh" "$@"
}

fake_release "$FIXTURE" 9.9.9

echo "==> install.sh"

# A pinned version installs the verified binary into --bin-dir and reports it.
fake_uname "$SHIM" Linux x86_64
bin="$work/bin1"
run_install --version v9.9.9 --bin-dir "$bin"
if [ "$status" -eq 0 ] && [ -x "$bin/yass" ] &&
	[ "$("$bin/yass" --version)" = "yass 9.9.9 v1 (linux_amd64)" ] &&
	printf '%s' "$out" | grep -q "installed $bin/yass"; then
	ok "installs a pinned version"
else
	bad "installs a pinned version: status=$status
$out"
fi

# Equals spellings select the verified release and preserve a directory with spaces.
bin="$work/equals bin"
run_install --version=9.9.9 --bin-dir="$bin"
if [ "$status" -eq 0 ] && [ -x "$bin/yass" ] &&
	[ "$("$bin/yass" --version)" = "yass 9.9.9 v1 (linux_amd64)" ]; then
	ok "accepts equals spellings and a directory with spaces"
else
	bad "accepts equals spellings and a directory with spaces: status=$status
$out"
fi

# The documented env vars work without options.
bin="$work/env-bin"
YASS_VERSION=v9.9.9 YASS_BIN_DIR="$bin" run_install
if [ "$status" -eq 0 ] && [ -x "$bin/yass" ] &&
	[ "$("$bin/yass" --version)" = "yass 9.9.9 v1 (linux_amd64)" ]; then
	ok "accepts version and directory environment variables"
else
	bad "accepts version and directory environment variables: status=$status
$out"
fi

# Both option spellings override incompatible env defaults rather than using them.
for spelling in spaced equals; do
	bin="$work/override-$spelling"
	env_bin="$work/unused-$spelling"
	if [ "$spelling" = spaced ]; then
		YASS_VERSION=1.0.0-nosuch YASS_BIN_DIR="$env_bin" \
			run_install --version v9.9.9 --bin-dir "$bin"
	else
		YASS_VERSION=1.0.0-nosuch YASS_BIN_DIR="$env_bin" \
			run_install --version=v9.9.9 --bin-dir="$bin"
	fi
	if [ "$status" -eq 0 ] && [ -x "$bin/yass" ] && [ ! -e "$env_bin" ] &&
		[ "$("$bin/yass" --version)" = "yass 9.9.9 v1 (linux_amd64)" ]; then
		ok "$spelling options override environment variables"
	else
		bad "$spelling options override environment variables: status=$status
$out"
	fi
done

# A bare version with no leading v selects the same release.
bin="$work/bin2"
run_install --version 9.9.9 --bin-dir "$bin"
if [ "$status" -eq 0 ] && [ -x "$bin/yass" ]; then
	ok "accepts a version without the leading v"
else
	bad "accepts a version without the leading v: status=$status
$out"
fi

# The archive matching the shimmed platform is the one installed.
fake_uname "$SHIM" Darwin arm64
bin="$work/bin3"
run_install --version 9.9.9 --bin-dir "$bin"
if [ "$status" -eq 0 ] && [ "$("$bin/yass" --version)" = "yass 9.9.9 v1 (darwin_arm64)" ]; then
	ok "selects the archive matching the host platform"
else
	bad "selects the archive matching the host platform: status=$status
$out"
fi

# An unsupported architecture is reported clearly and installs nothing.
fake_uname "$SHIM" Linux mips64
bin="$work/bin4"
run_install --version 9.9.9 --bin-dir "$bin"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "unsupported architecture mips64" &&
	[ ! -e "$bin/yass" ]; then
	ok "reports an unsupported architecture"
else
	bad "reports an unsupported architecture: status=$status
$out"
fi

# An unsupported operating system is reported clearly.
fake_uname "$SHIM" SunOS x86_64
run_install --version 9.9.9 --bin-dir "$work/bin5"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "unsupported operating system"; then
	ok "reports an unsupported operating system"
else
	bad "reports an unsupported operating system: status=$status
$out"
fi

# A checksum mismatch aborts before anything is installed.
fake_uname "$SHIM" Linux x86_64
tampered="$work/tampered"
cp -R "$FIXTURE" "$tampered"
asset_dir="$tampered/releases/download/v9.9.9"
printf 'tampered\n' >>"$asset_dir/yass_9.9.9_linux_amd64.tar.gz"
bin="$work/bin6"
repo="$tampered" run_install --version 9.9.9 --bin-dir "$bin"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "checksum mismatch" &&
	[ ! -e "$bin/yass" ]; then
	ok "aborts on a checksum mismatch and installs nothing"
else
	bad "aborts on a checksum mismatch and installs nothing: status=$status
$out"
fi

# A missing release is a clear download failure, not a checksum one.
bin="$work/bin7"
run_install --version 1.0.0-nosuch --bin-dir "$bin"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "cannot download" &&
	[ ! -e "$bin/yass" ]; then
	ok "reports a missing release"
else
	bad "reports a missing release: status=$status
$out"
fi

# An install directory that cannot be created is a clear failure. The target
# is a path under a regular file, so it fails for root as well.
blocker="$work/blocker"
: >"$blocker"
run_install --version 9.9.9 --bin-dir "$blocker/bin"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "cannot create"; then
	ok "reports an unusable install directory"
else
	bad "reports an unusable install directory: status=$status
$out"
fi

# A directory already at the install target is refused rather than nested into.
fake_uname "$SHIM" Linux x86_64
bin="$work/dir-target"
mkdir -p "$bin/yass"
run_install --version v9.9.9 --bin-dir "$bin"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "is a directory" &&
	[ ! -e "$bin/yass/yass" ]; then
	ok "refuses a directory at the install target"
else
	bad "refuses a directory at the install target: status=$status
$out"
fi

# A binary that installs but cannot execute fails the install rather than
# reporting success. The fixture swaps in a binary whose interpreter does not
# exist and regenerates its checksum line, so verification itself still passes.
broken="$work/broken"
cp -R "$FIXTURE" "$broken"
btmp=$(mktemp -d)
printf '#!/no/such/interpreter\n' >"$btmp/yass"
chmod 0755 "$btmp/yass"
btar="$broken/releases/download/v9.9.9/yass_9.9.9_linux_amd64.tar.gz"
tar -czf "$btar" -C "$btmp" yass
rm -rf "$btmp"
if command -v sha256sum >/dev/null 2>&1; then
	bsum=$(sha256sum "$btar" | cut -d' ' -f1)
else
	bsum=$(shasum -a 256 "$btar" | cut -d' ' -f1)
fi
awk -v a="yass_9.9.9_linux_amd64.tar.gz" -v s="$bsum" \
	'$2 == a { print s "  " a; next } { print }' \
	"$broken/releases/download/v9.9.9/checksums.txt" >"$broken/checksums.txt"
mv "$broken/checksums.txt" "$broken/releases/download/v9.9.9/checksums.txt"
bin="$work/broken-bin"
repo="$broken" run_install --version 9.9.9 --bin-dir "$bin"
if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "does not run" &&
	! printf '%s' "$out" | grep -q '^installed '; then
	ok "fails when the installed binary cannot run"
else
	bad "fails when the installed binary cannot run: status=$status
$out"
fi

# SIGINT during the download exits 130 through the EXIT cleanup instead of
# continuing against the deleted temp directory. The curl shim delivers the
# interrupt to the installer itself, the way a terminal delivers Ctrl-C to the
# whole foreground process group, and dies as curl would.
slowcurl="$work/slowcurl"
mkdir -p "$slowcurl"
cat >"$slowcurl/curl" <<-'EOF'
	#!/bin/sh
	kill -INT "$PPID"
	exit 130
	EOF
chmod 0755 "$slowcurl/curl"
intbin="$work/int-bin"
capture env PATH="$SHIM:$slowcurl:$PATH" YASS_REPO_URL="file://$FIXTURE" \
	sh "$REPO_ROOT/install.sh" --version v9.9.9 --bin-dir "$intbin"
if [ "$status" -eq 130 ] && ! printf '%s' "$out" | grep -q "checksum mismatch" &&
	[ ! -e "$intbin/yass" ]; then
	ok "exits 130 on SIGINT during download and installs nothing"
else
	bad "exits 130 on SIGINT during download and installs nothing: status=$status
$out"
fi

# With no --bin-dir and an unwritable /usr/local/bin, an unset HOME is a clear
# failure rather than a raw set -u abort. Skipped where /usr/local/bin is
# writable (root), because that branch never reaches HOME.
if [ -w /usr/local/bin ]; then
	ok "skips the unset-HOME case (/usr/local/bin is writable here)"
else
	capture env -u HOME PATH="$SHIM:$PATH" YASS_REPO_URL="file://$FIXTURE" \
		sh "$REPO_ROOT/install.sh" --version v9.9.9
	if [ "$status" -ne 0 ] && printf '%s' "$out" | grep -q "HOME is unset"; then
		ok "fails clearly when HOME is unset and /usr/local/bin is not writable"
	else
		bad "fails clearly when HOME is unset and /usr/local/bin is not writable: status=$status
$out"
	fi
fi

# The documented piped invocation has no install.sh on disk to read; the
# embedded usage makes `curl … | sh -s -- --help` print the real header.
capture sh -s -- --help <"$REPO_ROOT/install.sh"
if [ "$status" -eq 0 ] && printf '%s' "$out" | grep -q -- '--version TAG' &&
	printf '%s' "$out" | grep -q 'YASS_REPO_URL'; then
	ok "prints usage for a piped --help"
else
	bad "prints usage for a piped --help: status=$status
$out"
fi

# The embedded usage and the file header are the same text, so repo browsers
# and --help readers cannot drift apart. The header is the comment block
# between the shebang and the first blank line.
capture sh "$REPO_ROOT/install.sh" --help
header=$(awk 'NR == 1 { next } /^$/ { exit } { print }' "$REPO_ROOT/install.sh")
if [ "$status" -eq 0 ] && [ "$out" = "$header" ]; then
	ok "keeps --help identical to the file header"
else
	bad "keeps --help identical to the file header: status=$status
$out"
fi

echo "==> script/gen-formula"

# The generated formula carries the version and the published checksums.
formula="$work/yass.rb"
dist="$FIXTURE/releases/download/v9.9.9"
want=$(awk '$2 == "yass_9.9.9_darwin_arm64.tar.gz" { print $1 }' "$dist/checksums.txt")
if YASS_DIST_DIR="$dist" YASS_FORMULA="$formula" "$REPO_ROOT/script/gen-formula" 9.9.9 >/dev/null &&
	grep -q 'version "9.9.9"' "$formula" &&
	[ "$(grep -c 'sha256 "' "$formula")" -eq 4 ] &&
	grep -q "sha256 \"$want\"" "$formula"; then
	ok "generates the formula from dist/checksums.txt"
else
	bad "generates the formula from dist/checksums.txt"
fi

# A checksums.txt missing a target fails the generation rather than emitting a
# formula with a hole in it.
partial="$work/partial-dist"
mkdir -p "$partial"
grep -v darwin_arm64 "$dist/checksums.txt" >"$partial/checksums.txt"
capture env YASS_DIST_DIR="$partial" YASS_FORMULA="$work/partial.rb" \
	"$REPO_ROOT/script/gen-formula" 9.9.9
if [ "$status" -ne 0 ] && [ ! -e "$work/partial.rb" ]; then
	ok "refuses a checksums.txt missing a target"
else
	bad "refuses a checksums.txt missing a target: status=$status
$out"
fi

echo
if [ "$failures" -ne 0 ]; then
	echo "script/test-install: $failures failure(s)" >&2
	exit 1
fi
echo "script/test-install: all tests passed"
