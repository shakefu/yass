#!/usr/bin/env bash
#
# script/build — cross-compile the yass CLI release archives into dist/.
#
# Invoked by cocogitto's pre_bump_hooks (see cog.toml) during `cog bump`,
# which passes the planned version as $1 ({{version}}). Also runnable
# standalone: with no argument the version comes from `git describe`,
# falling back to "dev".
#
# Each target produces dist/yass_<version>_<os>_<arch>.tar.gz (.zip on
# windows) holding a single binary stamped via -ldflags -X so that
# `yass --version` reports the release version, plus dist/checksums.txt.
# The release workflow attaches dist/* to the GitHub release.
#
# Usage:
#   script/build            # version from git describe, else "dev"
#   script/build 1.2.3      # explicit version (a leading v is stripped)

set -euo pipefail

_repo_root() { cd "$(dirname "$0")"/.. && pwd; }
REPO_ROOT="$(_repo_root)"
DIST_DIR="${REPO_ROOT}/dist"
CLI_DIR="${REPO_ROOT}/cli"
PKG="github.com/shakefu/yass/cli/internal/yass"

ver="${1:-${VERSION:-}}"
if [[ -z "$ver" ]]; then
	ver="$(git -C "$REPO_ROOT" describe --tags --dirty --always 2>/dev/null || echo dev)"
fi
ver="${ver#v}"

rm -rf "$DIST_DIR"
mkdir -p "$DIST_DIR"

targets=(
	linux/amd64
	linux/arm64
	darwin/amd64
	darwin/arm64
	windows/amd64
)

cd "$CLI_DIR"
for target in "${targets[@]}"; do
	os="${target%/*}"
	arch="${target#*/}"
	name="yass_${ver}_${os}_${arch}"
	bin="yass"
	[[ "$os" == "windows" ]] && bin="yass.exe"

	echo "==> ${name}"
	tmp="$(mktemp -d)"
	CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" \
		go build -trimpath \
		-ldflags "-s -w -X ${PKG}.programVersion=${ver}" \
		-o "${tmp}/${bin}" .
	if [[ "$os" == "windows" ]]; then
		(cd "$tmp" && zip -q "${DIST_DIR}/${name}.zip" "$bin")
	else
		tar -czf "${DIST_DIR}/${name}.tar.gz" -C "$tmp" "$bin"
	fi
	rm -rf "$tmp"
done

cd "$DIST_DIR"
if command -v sha256sum >/dev/null 2>&1; then
	sha256sum yass_* >checksums.txt
else
	shasum -a 256 yass_* >checksums.txt
fi

echo "==> dist/:"
ls -1 "$DIST_DIR"
