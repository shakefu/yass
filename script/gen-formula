#!/usr/bin/env bash
#
# script/gen-formula — regenerate Formula/yass.rb from a release's checksums.
#
# Invoked by cocogitto's pre_bump_hooks (see cog.toml) after script/build, so
# every release commit carries a formula whose URLs and sha256 digests match
# the archives that release publishes. The formula is read by Homebrew from
# this repository as a tap:
#
#   brew tap shakefu/yass https://github.com/shakefu/yass
#   brew install yass
#
# Usage:
#   script/gen-formula VERSION   # reads dist/checksums.txt (a leading v is stripped)
#
# Environment, for tests:
#   YASS_DIST_DIR   directory holding checksums.txt (default dist/)
#   YASS_FORMULA    file to write (default Formula/yass.rb)

set -euo pipefail

_repo_root() { cd "$(dirname "$0")"/.. && pwd; }
REPO_ROOT="$(_repo_root)"
DIST_DIR="${YASS_DIST_DIR:-${REPO_ROOT}/dist}"
FORMULA="${YASS_FORMULA:-${REPO_ROOT}/Formula/yass.rb}"

ver="${1:-}"
if [[ -z "$ver" ]]; then
	echo "usage: script/gen-formula VERSION" >&2
	exit 2
fi
ver="${ver#v}"

checksums="${DIST_DIR}/checksums.txt"
if [[ ! -f "$checksums" ]]; then
	echo "script/gen-formula: ${checksums} not found; run script/build first" >&2
	exit 1
fi

# sha TARGET — the published digest of that target's archive, e.g. sha darwin_arm64.
sha() {
	local asset="yass_${ver}_$1.tar.gz" digest
	digest="$(awk -v a="$asset" '$2 == a { print $1 }' "$checksums")"
	if [[ -z "$digest" ]]; then
		echo "script/gen-formula: ${checksums} does not list ${asset}" >&2
		exit 1
	fi
	printf '%s' "$digest"
}

darwin_arm64="$(sha darwin_arm64)"
darwin_amd64="$(sha darwin_amd64)"
linux_arm64="$(sha linux_arm64)"
linux_amd64="$(sha linux_amd64)"

base="https://github.com/shakefu/yass/releases/download/v${ver}"

mkdir -p "$(dirname "$FORMULA")"
cat >"$FORMULA" <<EOF
# Generated by script/gen-formula for each release; do not edit by hand.
class Yass < Formula
  desc "Read-only CLI serving yass spec sets to coding agents"
  homepage "https://github.com/shakefu/yass"
  version "${ver}"
  license "AGPL-3.0-only"

  on_macos do
    if Hardware::CPU.arm?
      url "${base}/yass_${ver}_darwin_arm64.tar.gz"
      sha256 "${darwin_arm64}"
    else
      url "${base}/yass_${ver}_darwin_amd64.tar.gz"
      sha256 "${darwin_amd64}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "${base}/yass_${ver}_linux_arm64.tar.gz"
      sha256 "${linux_arm64}"
    else
      url "${base}/yass_${ver}_linux_amd64.tar.gz"
      sha256 "${linux_amd64}"
    end
  end

  def install
    bin.install "yass"
  end

  test do
    assert_match "yass ${ver}", shell_output("#{bin}/yass --version")
  end
end
EOF

# Inside the repository (the cog bump path), stage the formula so it rides the
# bump commit; standalone and test runs outside a work tree skip this.
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
	[[ "$FORMULA" == "$REPO_ROOT"/* ]]; then
	git -C "$REPO_ROOT" add "$FORMULA"
fi

echo "wrote ${FORMULA} for v${ver}"
